      "parameters": {
        "jsCode": "const api = $json;\nconst booking = $('Edit Fields').first().json;\n\nconst destination = String(booking.destination || \"\").trim();\nconst normalizedDestination = destination.toLowerCase();\n\nconst supportedDestinations = [\n  \"nigeria\",\n  \"ghana\",\n  \"kenya\"\n];\n\nconst available = supportedDestinations.includes(normalizedDestination);\n\nreturn {\n  json: {\n    name: booking.name,\n    bookingType: booking.bookingType,\n    destination: destination,\n    apiAvailable: available,\n    message: available\n      ? \"Destination is supported\"\n      : \"Destination requires review\"\n  }\n};"
